# Copy to .env and adjust. run.py loads this file automatically.

# Long random string; generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If omitted, a key is generated and stored in instance/secret_key.
# SECRET_KEY=change-me

# Database. Default (when unset) is SQLite at instance/phishguard.db.
# MySQL example (create the database first, see database/schema_mysql.sql):
# DATABASE_URL=mysql+pymysql://phishguard:your_password@localhost:3306/phishguard

# Optional machine-learning model (train with: python ml/train_model.py)
ML_ENABLED=1
# ML_MODEL_PATH=ml/model.joblib

# Login protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=10

# Set to 1 when served over HTTPS in production
SESSION_COOKIE_SECURE=0

# Development server
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
